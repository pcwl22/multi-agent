* text=auto eol=lf
*.png binary
*.jpg binary
*.whl binary
*.webm binary
# Unified diff context lines intentionally contain one leading space, including blank lines.
*.patch -whitespace
# Historical pilot holdouts retain their frozen raw bytes across platforms.
docs/iteration2/pilots/acceptance/*.py.txt -text whitespace=cr-at-eol
# Upstream license formatting is retained verbatim.
docs/iteration2/pilots/*-LICENSE.txt -whitespace

# Preserve preregistered historical case and hidden-oracle bytes across checkouts.
app/evaluation/historical_cases/*.json -text whitespace=cr-at-eol
app/evaluation/historical_cases/acceptance/*.txt -text whitespace=cr-at-eol

# Keep frozen historical evaluation evidence JSON byte-identical in Git.
docs/historical-evaluation-20261019/*.json -text whitespace=cr-at-eol
