REPOPILOT_REPOSITORY_ROOT=./demo_repository
REPOPILOT_DATA_DIR=./.repopilot
REPOPILOT_MODEL_MODE=mock
REPOPILOT_MODEL_NAME=gpt-4.1-mini
# OPENAI_API_KEY=
# REPOPILOT_MODEL_BASE_URL=
# Optional process-wide pacing across models using the same endpoint (seconds).
# REPOPILOT_MODEL_MIN_INTERVAL=7.5
# Optional streaming for providers buffering long responses.
REPOPILOT_MODEL_STREAMING=false
# Disable usage requests only if the provider rejects stream_options.
REPOPILOT_MODEL_STREAM_USAGE=true
# Include bounded workspace paths and remote subdirectory mappings.
REPOPILOT_MODEL_PATH_SCOPE=true
REPOPILOT_SANDBOX_IMAGE=repopilot-sandbox:local
REPOPILOT_MAX_RETRIES=2
REPOPILOT_TEST_TIMEOUT=60
# Optional draft PR publishing; disabled unless explicitly configured and approved in UI.
# REPOPILOT_GITHUB_REPOSITORY=owner/repository
# REPOPILOT_GITHUB_REPOSITORY_SUBDIRECTORY=demo_repository
# REPOPILOT_GITHUB_BASE_BRANCH=main
# GITHUB_TOKEN=
# Optional opt-in tracing; repository source may leave your computer.
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=

# Opt-in durable patch intentions and explicit digest-bound recovery for NEW tasks.
REPOPILOT_PATCH_TRANSACTIONS=false

# Optional persistent budgets for NEW tasks; existing tasks keep their saved policy.
REPOPILOT_TASK_BUDGETS=false
# Trusted server-side JSON. Deadline includes queue/offline/cooldown time until repair finishes.
REPOPILOT_BUDGET_LIMITS={"wall_seconds":900,"model_requests":20,"observed_tokens":200000,"sandbox_runs":10,"artifact_bytes":268435456,"result_bytes":8388608}

# Opt-in quality policy for NEW tasks; requires isolated retries and patch transactions.
REPOPILOT_REPAIR_QUALITY_CHECKS=false
# REPOPILOT_RETRY_WORKSPACE_POLICY=isolated

# Version 2 derives actual bindings and safely composes independent original-anchored edits.
# Version 1 retains the strict first-experiment behavior for reproducibility.
REPOPILOT_REPAIR_QUALITY_POLICY_VERSION=2

# Batch evaluations only: matching failures pause all new model dispatches; 0 disables.
REPOPILOT_EVALUATION_PROVIDER_FAILURE_THRESHOLD=3
