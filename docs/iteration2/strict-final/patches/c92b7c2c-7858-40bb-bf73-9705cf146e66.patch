--- a/slugs.py
+++ b/slugs.py
@@ -1,5 +1,10 @@
 import re
+import unicodedata
 
 
 def slugify(value):
-    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
+    decomposed = unicodedata.normalize("NFKD", value)
+    ascii_value = "".join(
+        char for char in decomposed if not unicodedata.combining(char)
+    )
+    return re.sub(r"[^a-z0-9]+", "-", ascii_value.lower()).strip("-")
--- a/tests/test_slugify_unicode.py
+++ b/tests/test_slugify_unicode.py
@@ -0,0 +1,33 @@
+from slugs import slugify
+
+
+def test_precomposed_accent_transliteration():
+    assert slugify("Caf\u00e9 d\u00e9j\u00e0 vu") == "cafe-deja-vu"
+
+
+def test_decomposed_accent_matches_precomposed():
+    decomposed = "cafe\u0301"
+    precomposed = "caf\u00e9"
+    assert slugify(decomposed) == slugify(precomposed) == "cafe"
+
+
+def test_decomposed_accent_in_phrase():
+    assert slugify("Cafe\u0301 de\u0301ja\u0300 vu") == "cafe-deja-vu"
+
+
+def test_ascii_word_separation_preserved():
+    assert slugify("Hello, World!") == "hello-world"
+
+
+def test_dashes_trimmed():
+    assert slugify("  --Caf\u00e9--  ") == "cafe"
+
+
+def test_empty_string():
+    assert slugify("") == ""
+
+
+def test_result_is_ascii_str():
+    result = slugify("Caf\u00e9 d\u00e9j\u00e0 vu")
+    assert isinstance(result, str)
+    assert result.isascii()
