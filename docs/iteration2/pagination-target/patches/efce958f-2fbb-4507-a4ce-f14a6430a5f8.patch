--- a/pagination.py
+++ b/pagination.py
@@ -1,5 +1,5 @@
 def paginate(items, page, page_size):
     if page < 1 or page_size < 1:
         return []
-    start = page * page_size
-    return items[start : start + page_size]
+    start = (page - 1) * page_size
+    return list(items[start : start + page_size])
--- a/tests/test_pagination_issue_regression.py
+++ b/tests/test_pagination_issue_regression.py
@@ -0,0 +1,56 @@
+from pagination import paginate
+
+
+def test_issue_literal_range_page_two_size_two():
+    # Literal issue input passed unchanged; one-based page numbers.
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_issue_literal_range_first_page():
+    result = paginate(range(1, 8), 1, 2)
+    assert result == [1, 2]
+    assert isinstance(result, list)
+
+
+def test_issue_literal_range_last_full_page():
+    result = paginate(range(1, 8), 3, 2)
+    assert result == [5, 6]
+    assert isinstance(result, list)
+
+
+def test_issue_literal_range_partial_last_page():
+    result = paginate(range(1, 8), 4, 2)
+    assert result == [7]
+    assert isinstance(result, list)
+
+
+def test_issue_literal_range_beyond_last_page():
+    result = paginate(range(1, 8), 5, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_empty_input_returns_empty_list():
+    result = paginate([], 1, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_invalid_page_returns_empty_list():
+    result = paginate([1, 2], 0, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_invalid_page_size_returns_empty_list():
+    result = paginate([1, 2], 1, 0)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_input_not_mutated():
+    items = [1, 2, 3, 4, 5, 6, 7]
+    paginate(items, 2, 2)
+    assert items == [1, 2, 3, 4, 5, 6, 7]
--- a/tests/test_pagination_regression.py
+++ b/tests/test_pagination_regression.py
@@ -0,0 +1,44 @@
+from pagination import paginate
+
+
+def test_page_two_size_two_on_range_1_8():
+    # Literal issue input passed unchanged; one-based page numbers.
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_first_page_on_range_1_8():
+    assert paginate(range(1, 8), 1, 2) == [1, 2]
+
+
+def test_last_full_page_on_range_1_8():
+    assert paginate(range(1, 8), 3, 2) == [5, 6]
+
+
+def test_partial_last_page_on_range_1_8():
+    assert paginate(range(1, 8), 4, 2) == [7]
+
+
+def test_beyond_last_page_returns_empty_list():
+    result = paginate(range(1, 8), 5, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_empty_input_returns_empty_list():
+    assert paginate([], 1, 2) == []
+
+
+def test_invalid_page_returns_empty_list():
+    assert paginate([1, 2], 0, 2) == []
+
+
+def test_invalid_page_size_returns_empty_list():
+    assert paginate([1, 2], 1, 0) == []
+
+
+def test_input_not_mutated():
+    items = [1, 2, 3, 4, 5, 6, 7]
+    paginate(items, 2, 2)
+    assert items == [1, 2, 3, 4, 5, 6, 7]
