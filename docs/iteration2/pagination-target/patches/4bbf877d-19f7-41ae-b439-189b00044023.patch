--- a/pagination.py
+++ b/pagination.py
@@ -1,5 +1,5 @@
 def paginate(items, page, page_size):
     if page < 1 or page_size < 1:
         return []
-    start = page * page_size
-    return items[start : start + page_size]
+    start = (page - 1) * page_size
+    return list(items[start : start + page_size])
--- a/tests/test_pagination_contract_regression.py
+++ b/tests/test_pagination_contract_regression.py
@@ -0,0 +1,47 @@
+from pagination import paginate
+
+
+def test_page_two_size_two_on_range_returns_list_3_4():
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_first_page_on_range_returns_list_1_2():
+    result = paginate(range(1, 8), 1, 2)
+    assert result == [1, 2]
+    assert isinstance(result, list)
+
+
+def test_last_partial_page_on_range_returns_list_7():
+    result = paginate(range(1, 8), 4, 2)
+    assert result == [7]
+    assert isinstance(result, list)
+
+
+def test_empty_input_returns_empty_list():
+    result = paginate([], 1, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_non_positive_page_returns_empty_list():
+    assert paginate([1, 2, 3], 0, 2) == []
+    assert paginate([1, 2, 3], -1, 2) == []
+
+
+def test_non_positive_page_size_returns_empty_list():
+    assert paginate([1, 2, 3], 1, 0) == []
+    assert paginate([1, 2, 3], 1, -2) == []
+
+
+def test_page_beyond_last_page_returns_empty_list():
+    result = paginate(range(1, 8), 10, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_list_input_preserved():
+    result = paginate([1, 2, 3, 4, 5], 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
--- a/tests/test_pagination_regression.py
