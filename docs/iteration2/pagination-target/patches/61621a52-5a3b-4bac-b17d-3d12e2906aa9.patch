--- a/pagination.py
+++ b/pagination.py
@@ -1,5 +1,5 @@
 def paginate(items, page, page_size):
     if page < 1 or page_size < 1:
         return []
-    start = page * page_size
-    return items[start : start + page_size]
+    start = (page - 1) * page_size
+    return list(items[start : start + page_size])
--- a/tests/test_pagination_regression.py
+++ b/tests/test_pagination_regression.py
@@ -0,0 +1,66 @@
+from pagination import paginate
+
+
+def test_issue_literal_example_range_1_8_page_2_size_2():
+    # Literal example from the issue: range(1, 8), page 2, size 2 -> [3, 4]
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_first_page_is_one_based():
+    # Page 1 must be the first page, not the second.
+    assert paginate(range(1, 8), 1, 2) == [1, 2]
+
+
+def test_third_page_one_based():
+    assert paginate(range(1, 8), 3, 2) == [5, 6]
+
+
+def test_last_partial_page():
+    assert paginate(range(1, 8), 4, 2) == [7]
+
+
+def test_beyond_last_page_returns_empty_list():
+    result = paginate(range(1, 8), 10, 2)
+    assert result == []
+    assert isinstance(result, list)
+
+
+def test_empty_input_preserved():
+    assert paginate([], 1, 2) == []
+    assert paginate([], 5, 3) == []
+
+
+def test_invalid_page_preserved():
+    assert paginate([1, 2, 3], 0, 2) == []
+    assert paginate([1, 2, 3], -1, 2) == []
+
+
+def test_invalid_page_size_preserved():
+    assert paginate([1, 2, 3], 1, 0) == []
+    assert paginate([1, 2, 3], 1, -2) == []
+
+
+def test_page_size_one():
+    assert paginate(range(1, 8), 1, 1) == [1]
+    assert paginate(range(1, 8), 7, 1) == [7]
+    assert paginate(range(1, 8), 8, 1) == []
+
+
+def test_page_size_larger_than_input():
+    assert paginate(range(1, 8), 1, 100) == [1, 2, 3, 4, 5, 6, 7]
+    assert paginate(range(1, 8), 2, 100) == []
+
+
+def test_does_not_mutate_input():
+    items = [1, 2, 3, 4, 5, 6, 7]
+    snapshot = list(items)
+    paginate(items, 2, 2)
+    assert items == snapshot
+
+
+def test_returns_list_type_for_list_input():
+    result = paginate([1, 2, 3, 4, 5, 6, 7], 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
