 def discounted(amount, percent):
-    return amount * (1 - percent)
+    """Return the amount after applying ``percent`` as a percentage discount.
+
+    A ``percent`` of 20 means 20% off, so ``discounted(100, 20) == 80``.
+    A ``percent`` of 0 leaves the amount unchanged.
+    """
+    return amount * (1 - percent / 100.0)
