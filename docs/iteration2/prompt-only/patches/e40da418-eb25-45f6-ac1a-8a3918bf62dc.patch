--- a/tests/test_available_units_regression.py
+++ b/tests/test_available_units_regression.py
@@ -0,0 +1,73 @@
+from inventory import available_units
+
+
+def test_literal_example_repeated_sku():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    result = available_units(stock, reservations)
+    assert result == {"A": 5}
+    assert isinstance(result, dict)
+
+
+def test_repeated_sku_entries_all_subtracted():
+    result = available_units({"A": 100}, [("A", 1), ("A", 2), ("A", 3)])
+    assert result == {"A": 94}
+
+
+def test_clamped_at_zero():
+    result = available_units({"A": 1}, [("A", 5)])
+    assert result == {"A": 0}
+    assert isinstance(result["A"], int)
+
+
+def test_clamped_at_zero_with_repeated_skus():
+    result = available_units({"A": 4}, [("A", 3), ("A", 3)])
+    assert result == {"A": 0}
+
+
+def test_unknown_sku_reservations_ignored():
+    result = available_units({"A": 5}, [("B", 3)])
+    assert result == {"A": 5}
+    assert set(result.keys()) == {"A"}
+
+
+def test_unknown_and_known_sku_mixed():
+    result = available_units({"A": 5}, [("B", 3), ("A", 2), ("C", 9)])
+    assert result == {"A": 3}
+    assert set(result.keys()) == {"A"}
+
+
+def test_empty_reservations_returns_copy_of_stock():
+    stock = {"A": 7, "B": 0}
+    result = available_units(stock, [])
+    assert result == {"A": 7, "B": 0}
+    assert result is not stock
+
+
+def test_output_keys_match_stock_keys():
+    stock = {"A": 10, "B": 4, "C": 0}
+    result = available_units(stock, [("A", 1), ("B", 2)])
+    assert set(result.keys()) == set(stock.keys())
+    assert isinstance(result, dict)
+
+
+def test_input_stock_not_mutated():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    available_units(stock, reservations)
+    assert stock == {"A": 10}
+
+
+def test_input_reservations_not_mutated():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    available_units(stock, reservations)
+    assert reservations == [("A", 2), ("A", 3)]
+
+
+def test_inputs_not_mutated_with_unknown_sku():
+    stock = {"A": 5}
+    reservations = [("B", 3), ("A", 1)]
+    available_units(stock, reservations)
+    assert stock == {"A": 5}
+    assert reservations == [("B", 3), ("A", 1)]
