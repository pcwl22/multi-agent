--- a/tests/test_inventory_regression.py
+++ b/tests/test_inventory_regression.py
@@ -0,0 +1,61 @@
+import copy
+
+from inventory import available_units
+
+
+def test_repeated_sku_entries_are_summed():
+    # Literal example from the issue.
+    assert available_units({"A": 10}, [("A", 2), ("A", 3)]) == {"A": 5}
+
+
+def test_repeated_sku_entries_all_counted_not_just_one():
+    # Three entries for the same SKU must all be subtracted.
+    assert available_units({"A": 10}, [("A", 1), ("A", 2), ("A", 3)]) == {"A": 4}
+
+
+def test_clamped_at_zero():
+    assert available_units({"A": 1}, [("A", 5)]) == {"A": 0}
+
+
+def test_clamped_at_zero_with_repeated_entries():
+    assert available_units({"A": 3}, [("A", 2), ("A", 2)]) == {"A": 0}
+
+
+def test_unknown_sku_reservations_ignored():
+    assert available_units({"A": 10}, [("B", 4)]) == {"A": 10}
+
+
+def test_unknown_sku_ignored_alongside_known_sku():
+    assert available_units({"A": 10}, [("A", 2), ("B", 4)]) == {"A": 8}
+
+
+def test_stock_input_not_mutated():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    stock_before = copy.deepcopy(stock)
+    available_units(stock, reservations)
+    assert stock == stock_before
+
+
+def test_reservations_input_not_mutated():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    reservations_before = copy.deepcopy(reservations)
+    available_units(stock, reservations)
+    assert reservations == reservations_before
+
+
+def test_return_type_is_dict_of_ints():
+    result = available_units({"A": 10}, [("A", 2), ("A", 3)])
+    assert isinstance(result, dict)
+    assert set(result.keys()) == {"A"}
+    assert isinstance(result["A"], int)
+    assert result["A"] == 5
+
+
+def test_empty_inputs():
+    assert available_units({}, []) == {}
+
+
+def test_no_reservations_returns_stock_values():
+    assert available_units({"A": 10, "B": 4}, []) == {"A": 10, "B": 4}
