--- a/pagination.py
+++ b/pagination.py
@@ -1,5 +1,5 @@
 def paginate(items, page, page_size):
     if page < 1 or page_size < 1:
         return []
-    start = page * page_size
-    return items[start : start + page_size]
+    start = (page - 1) * page_size
+    return list(items[start : start + page_size])
--- a/tests/test_pagination_regression.py
+++ b/tests/test_pagination_regression.py
@@ -0,0 +1,46 @@
+from pagination import paginate
+
+
+def test_literal_example_one_based():
+    # range(1, 8) with page=2, size=2 -> [3, 4]
+    assert paginate(range(1, 8), 2, 2) == [3, 4]
+
+
+def test_first_page():
+    assert paginate(range(1, 8), 1, 2) == [1, 2]
+
+
+def test_last_partial_page():
+    assert paginate(range(1, 8), 4, 2) == [7]
+
+
+def test_beyond_last_page_returns_empty():
+    assert paginate(range(1, 8), 5, 2) == []
+
+
+def test_empty_input_preserved():
+    assert paginate([], 1, 2) == []
+
+
+def test_invalid_page_and_size_return_empty():
+    assert paginate(range(1, 8), 0, 2) == []
+    assert paginate(range(1, 8), 1, 0) == []
+    assert paginate(range(1, 8), -1, 2) == []
+    assert paginate(range(1, 8), 1, -2) == []
+
+
+def test_size_larger_than_input():
+    assert paginate(range(1, 8), 1, 100) == [1, 2, 3, 4, 5, 6, 7]
+
+
+def test_return_type_is_list():
+    result = paginate(range(1, 8), 2, 2)
+    assert isinstance(result, list)
+    assert result == [3, 4]
+
+
+def test_input_not_mutated():
+    items = [1, 2, 3, 4, 5, 6, 7]
+    snapshot = list(items)
+    paginate(items, 2, 2)
+    assert items == snapshot
--- a/tests/test_pagination_regression_v2.py
