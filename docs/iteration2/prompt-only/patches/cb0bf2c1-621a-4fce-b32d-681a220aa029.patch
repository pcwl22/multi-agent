--- a/tests/test_regression_checkout_totals.py
+++ b/tests/test_regression_checkout_totals.py
@@ -0,0 +1,33 @@
+from checkout import invoice_total
+from money import discounted
+
+
+def test_discount_20_means_20_percent():
+    # 100 with a 20% discount -> 80
+    assert discounted(100, 20) == 80
+
+
+def test_invoice_total_applies_tax_to_discounted_subtotal():
+    # subtotal 100, discount 20%, tax 10% -> 80 + 8 = 88
+    assert invoice_total(100, 20, 0.1) == 88
+
+
+def test_discount_zero_preserves_amount():
+    assert discounted(100, 0) == 100
+
+
+def test_invoice_total_tax_only():
+    assert invoice_total(100, 0, 0.1) == 110
+
+
+def test_invoice_total_discount_only():
+    assert invoice_total(100, 20, 0) == 80
+
+
+def test_invoice_total_no_discount_no_tax():
+    assert invoice_total(100, 0, 0) == 100
+
+
+def test_return_types_are_numeric():
+    assert isinstance(discounted(100, 20), (int, float))
+    assert isinstance(invoice_total(100, 20, 0.1), (int, float))
