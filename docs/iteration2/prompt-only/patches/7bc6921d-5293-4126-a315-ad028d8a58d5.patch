--- a/tests/test_inventory_regression.py
+++ b/tests/test_inventory_regression.py
@@ -0,0 +1,70 @@
+from copy import deepcopy
+
+from inventory import available_units
+
+
+def test_literal_example_repeated_sku():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    result = available_units(stock, reservations)
+    assert result == {"A": 5}
+    assert isinstance(result, dict)
+    assert result["A"] == 5
+    assert isinstance(result["A"], int)
+
+
+def test_repeated_sku_entries_all_summed():
+    result = available_units({"A": 100}, [("A", 1), ("A", 2), ("A", 3)])
+    assert result == {"A": 94}
+
+
+def test_clamped_at_zero():
+    result = available_units({"A": 1}, [("A", 5)])
+    assert result == {"A": 0}
+    assert result["A"] == 0
+
+
+def test_clamped_at_zero_with_repeated_skus():
+    result = available_units({"A": 4}, [("A", 3), ("A", 3)])
+    assert result == {"A": 0}
+
+
+def test_unknown_skus_ignored():
+    result = available_units({"A": 10}, [("B", 4)])
+    assert result == {"A": 10}
+
+
+def test_unknown_skus_ignored_alongside_known():
+    result = available_units({"A": 10}, [("A", 2), ("B", 4), ("B", 1)])
+    assert result == {"A": 8}
+
+
+def test_stock_input_not_mutated():
+    stock = {"A": 10, "B": 5}
+    reservations = [("A", 2), ("A", 3), ("B", 1)]
+    stock_before = deepcopy(stock)
+    available_units(stock, reservations)
+    assert stock == stock_before
+
+
+def test_reservations_input_not_mutated():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    reservations_before = deepcopy(reservations)
+    available_units(stock, reservations)
+    assert reservations == reservations_before
+
+
+def test_return_mapping_covers_every_stock_sku():
+    result = available_units({"A": 10, "B": 0}, [("A", 2)])
+    assert set(result.keys()) == {"A", "B"}
+    assert result == {"A": 8, "B": 0}
+    assert all(isinstance(v, int) and v >= 0 for v in result.values())
+
+
+def test_empty_inputs():
+    assert available_units({}, []) == {}
+
+
+def test_no_reservations_returns_stock_quantities():
+    assert available_units({"A": 7}, []) == {"A": 7}
