--- a/tests/test_parse_event_time_utc.py
+++ b/tests/test_parse_event_time_utc.py
@@ -0,0 +1,47 @@
+from datetime import datetime, timezone
+
+from events import parse_event_time
+
+
+def test_positive_offset_converted_to_utc():
+    result = parse_event_time("2026-04-01T12:00:00+02:00")
+    assert result == datetime(2026, 4, 1, 10, 0, tzinfo=timezone.utc)
+    assert isinstance(result, datetime)
+    assert result.tzinfo is timezone.utc
+
+
+def test_z_suffix_preserved_as_utc():
+    result = parse_event_time("2026-04-01T12:00:00Z")
+    assert result == datetime(2026, 4, 1, 12, 0, tzinfo=timezone.utc)
+    assert isinstance(result, datetime)
+    assert result.tzinfo is timezone.utc
+
+
+def test_naive_treated_as_utc():
+    result = parse_event_time("2026-04-01T12:00:00")
+    assert result == datetime(2026, 4, 1, 12, 0, tzinfo=timezone.utc)
+    assert isinstance(result, datetime)
+    assert result.tzinfo is timezone.utc
+
+
+def test_negative_offset_converted_to_utc():
+    result = parse_event_time("2026-04-01T12:00:00-05:00")
+    assert result == datetime(2026, 4, 1, 17, 0, tzinfo=timezone.utc)
+    assert isinstance(result, datetime)
+    assert result.tzinfo is timezone.utc
+
+
+def test_zero_offset_unchanged():
+    result = parse_event_time("2026-04-01T12:00:00+00:00")
+    assert result == datetime(2026, 4, 1, 12, 0, tzinfo=timezone.utc)
+    assert isinstance(result, datetime)
+    assert result.tzinfo is timezone.utc
+
+
+def test_same_instant_across_offsets():
+    assert parse_event_time("2026-04-01T12:00:00+02:00") == parse_event_time(
+        "2026-04-01T10:00:00Z"
+    )
+    assert parse_event_time("2026-04-01T12:00:00-05:00") == parse_event_time(
+        "2026-04-01T17:00:00+00:00"
+    )
