--- a/tests/test_regression_checkout_totals.py
+++ b/tests/test_regression_checkout_totals.py
@@ -0,0 +1,30 @@
+from checkout import invoice_total
+from money import discounted
+
+
+def test_discounted_interprets_percent_as_percentage():
+    # 20 means 20%, so 100 - 20% = 80
+    result = discounted(100, 20)
+    assert result == 80
+    assert isinstance(result, (int, float))
+
+
+def test_discounted_no_discount_preserved():
+    assert discounted(100, 0) == 100
+
+
+def test_invoice_total_applies_tax_to_discounted_subtotal():
+    # 100, discount 20%, tax 10% -> 80 + 8 = 88
+    result = invoice_total(100, 20, 0.1)
+    assert result == 88
+    assert isinstance(result, float)
+
+
+def test_invoice_total_no_discount_no_tax_preserved():
+    assert invoice_total(100, 0, 0.1) == 110
+    assert invoice_total(100, 0, 0) == 100
+    assert invoice_total(0, 20, 0.1) == 0
+
+
+def test_invoice_total_zero_amount_with_discount_and_tax():
+    assert invoice_total(0, 20, 0.1) == 0
