--- a/slugs.py
+++ b/slugs.py
@@ -1,5 +1,10 @@
 import re
+import unicodedata
 
 
 def slugify(value):
-    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
+    normalized = unicodedata.normalize("NFKD", value)
+    ascii_text = "".join(
+        ch for ch in normalized if not unicodedata.combining(ch)
+    )
+    return re.sub(r"[^a-z0-9]+", "-", ascii_text.lower()).strip("-")
--- a/tests/test_slugify_unicode.py
+++ b/tests/test_slugify_unicode.py
@@ -0,0 +1,30 @@
+from slugs import slugify
+
+
+def test_precomposed_accented_phrase():
+    assert slugify("Caf\u00e9 d\u00e9j\u00e0 vu") == "cafe-deja-vu"
+
+
+def test_decomposed_matches_precomposed():
+    assert slugify("cafe" + "\u0301") == slugify("caf\u00e9")
+    assert slugify("cafe" + "\u0301") == "cafe"
+
+
+def test_output_type_and_charset():
+    result = slugify("Caf\u00e9 d\u00e9j\u00e0 vu")
+    assert isinstance(result, str)
+    assert all(c.islower() or c.isdigit() or c == "-" for c in result)
+    assert all(ord(c) < 128 for c in result)
+    assert "--" not in result
+
+
+def test_ascii_word_separation_preserved():
+    assert slugify("Hello World!") == "hello-world"
+
+
+def test_leading_trailing_dashes_trimmed():
+    assert slugify("  --Hello--  ") == "hello"
+
+
+def test_empty_string():
+    assert slugify("") == ""
