--- a/pagination.py
+++ b/pagination.py
@@ -1,5 +1,5 @@
 def paginate(items, page, page_size):
     if page < 1 or page_size < 1:
         return []
-    start = page * page_size
+    start = (page - 1) * page_size
     return items[start : start + page_size]
--- a/tests/test_pagination_regression.py
+++ b/tests/test_pagination_regression.py
@@ -0,0 +1,43 @@
+from pagination import paginate
+
+
+def test_page_two_size_two_returns_third_and_fourth():
+    # Literal issue example: one-based page numbers.
+    result = paginate(list(range(1, 8)), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_first_page_returns_first_items():
+    assert paginate(list(range(1, 8)), 1, 2) == [1, 2]
+
+
+def test_last_partial_page():
+    assert paginate(list(range(1, 8)), 4, 2) == [7]
+
+
+def test_beyond_last_page_returns_empty():
+    assert paginate(list(range(1, 8)), 5, 2) == []
+    assert paginate(list(range(1, 8)), 100, 2) == []
+
+
+def test_empty_input_returns_empty():
+    assert paginate([], 1, 2) == []
+    assert paginate([], 3, 5) == []
+
+
+def test_invalid_page_returns_empty():
+    assert paginate([1, 2, 3], 0, 2) == []
+    assert paginate([1, 2, 3], -1, 2) == []
+
+
+def test_invalid_page_size_returns_empty():
+    assert paginate([1, 2, 3], 1, 0) == []
+    assert paginate([1, 2, 3], 1, -2) == []
+
+
+def test_input_not_mutated():
+    items = [1, 2, 3, 4, 5]
+    snapshot = list(items)
+    paginate(items, 2, 2)
+    assert items == snapshot
