--- a/slugs.py
+++ b/slugs.py
@@ -1,5 +1,13 @@
 import re
+import unicodedata
 
 
 def slugify(value):
-    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
+    # Decompose Unicode so combining accents are separated from base letters,
+    # then drop the combining marks. This makes precomposed and decomposed
+    # forms (e.g. "caf\u00e9" and "cafe\u0301") produce identical slugs.
+    decomposed = unicodedata.normalize("NFD", value)
+    without_marks = "".join(
+        ch for ch in decomposed if not unicodedata.combining(ch)
+    )
+    return re.sub(r"[^a-z0-9]+", "-", without_marks.lower()).strip("-")
--- a/tests/test_slugify_unicode.py
+++ b/tests/test_slugify_unicode.py
@@ -0,0 +1,28 @@
+from slugs import slugify
+
+
+def test_precomposed_accent_transliterated():
+    assert slugify("Caf\u00e9 d\u00e9j\u00e0 vu") == "cafe-deja-vu"
+
+
+def test_decomposed_matches_precomposed():
+    decomposed = "cafe\u0301 de\u0301ja\u0300 vu"
+    assert slugify(decomposed) == slugify("Caf\u00e9 d\u00e9j\u00e0 vu")
+    assert slugify(decomposed) == "cafe-deja-vu"
+
+
+def test_ascii_word_separation_preserved():
+    assert slugify("Hello, World!") == "hello-world"
+
+
+def test_dashes_trimmed():
+    assert slugify("  --Caf\u00e9--  ") == "cafe"
+    assert slugify("!!!") == ""
+
+
+def test_empty_string():
+    assert slugify("") == ""
+
+
+def test_result_type_is_str():
+    assert isinstance(slugify("Caf\u00e9"), str)
