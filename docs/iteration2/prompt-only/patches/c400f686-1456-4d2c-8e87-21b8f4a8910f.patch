--- a/config.py
+++ b/config.py
@@ -1,4 +1,32 @@
+import copy
+from collections.abc import Mapping
+
+
 def merge_config(defaults, overrides):
-    result = dict(defaults)
-    result.update(overrides)
+    """Recursively merge ``overrides`` into ``defaults``.
+
+    Nested mappings are merged recursively with ``overrides`` winning at
+    leaves.  Non-mapping values (including lists) are replaced, not
+    concatenated.  The returned mapping is independent of both inputs: it
+    never mutates them and shares no nested objects with them.
+    """
+    result = {}
+    for key, value in defaults.items():
+        if isinstance(value, Mapping):
+            result[key] = copy.deepcopy(dict(value))
+        else:
+            result[key] = copy.deepcopy(value)
+
+    for key, value in overrides.items():
+        if (
+            key in result
+            and isinstance(result[key], Mapping)
+            and isinstance(value, Mapping)
+        ):
+            result[key] = merge_config(result[key], value)
+        elif isinstance(value, Mapping):
+            result[key] = copy.deepcopy(dict(value))
+        else:
+            result[key] = copy.deepcopy(value)
+
     return result
--- a/tests/test_merge_config_regression.py
+++ b/tests/test_merge_config_regression.py
@@ -0,0 +1,83 @@
+from config import merge_config
+
+
+def test_nested_merge_override_wins_at_leaves():
+    base = {"a": {"b": 1, "c": 2}, "d": 3}
+    override = {"a": {"b": 10, "e": 5}}
+    result = merge_config(base, override)
+    assert result == {"a": {"b": 10, "c": 2, "e": 5}, "d": 3}
+    assert isinstance(result, dict)
+    assert isinstance(result["a"], dict)
+
+
+def test_deeply_nested_merge():
+    base = {"a": {"b": {"c": 1, "d": 2}}}
+    override = {"a": {"b": {"c": 9}}}
+    result = merge_config(base, override)
+    assert result == {"a": {"b": {"c": 9, "d": 2}}}
+
+
+def test_lists_are_replaced_not_concatenated():
+    base = {"items": [1, 2, 3]}
+    override = {"items": [4]}
+    result = merge_config(base, override)
+    assert result == {"items": [4]}
+    assert isinstance(result["items"], list)
+
+
+def test_list_replaced_inside_nested_mapping():
+    base = {"a": {"items": [1, 2]}}
+    override = {"a": {"items": [3]}}
+    result = merge_config(base, override)
+    assert result == {"a": {"items": [3]}}
+
+
+def test_base_input_not_mutated():
+    base = {"a": {"b": 1}, "items": [1, 2]}
+    override = {"a": {"b": 2, "c": 3}, "items": [9]}
+    base_snapshot = {"a": {"b": 1}, "items": [1, 2]}
+    merge_config(base, override)
+    assert base == base_snapshot
+
+
+def test_override_input_not_mutated():
+    base = {"a": {"b": 1}}
+    override = {"a": {"b": 2, "c": 3}, "items": [9]}
+    override_snapshot = {"a": {"b": 2, "c": 3}, "items": [9]}
+    merge_config(base, override)
+    assert override == override_snapshot
+
+
+def test_result_shares_no_nested_objects_with_base():
+    base = {"a": {"b": 1}, "items": [1, 2]}
+    override = {"a": {"b": 2}}
+    result = merge_config(base, override)
+    assert result is not base
+    assert result["a"] is not base["a"]
+    assert result["items"] is not base["items"]
+
+
+def test_result_shares_no_nested_objects_with_override():
+    base = {"a": {"b": 1}}
+    override = {"a": {"b": 2}, "items": [9]}
+    result = merge_config(base, override)
+    assert result is not override
+    assert result["a"] is not override["a"]
+    assert result["items"] is not override["items"]
+
+
+def test_mutating_result_does_not_affect_inputs():
+    base = {"a": {"b": 1}}
+    override = {"a": {"b": 2}}
+    result = merge_config(base, override)
+    result["a"]["b"] = 99
+    result["a"]["new"] = 1
+    assert base == {"a": {"b": 1}}
+    assert override == {"a": {"b": 2}}
+
+
+def test_simple_override_preserved():
+    assert merge_config({"a": 1}, {"a": 2, "b": 3}) == {"a": 2, "b": 3}
+    assert merge_config({}, {}) == {}
+    assert merge_config({"a": 1}, {}) == {"a": 1}
+    assert merge_config({}, {"a": 1}) == {"a": 1}
