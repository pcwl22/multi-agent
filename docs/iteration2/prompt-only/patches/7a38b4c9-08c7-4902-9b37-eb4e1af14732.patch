--- a/cache.py
+++ b/cache.py
@@ -1,2 +1,2 @@
 def is_expired(inserted_at, ttl, now):
-    return now > inserted_at + ttl
+    return now >= inserted_at + ttl
--- a/tests/test_expiry_boundary.py
+++ b/tests/test_expiry_boundary.py
@@ -0,0 +1,34 @@
+from cache import is_expired
+
+
+def test_zero_ttl_expired_at_insertion_time():
+    # ttl == 0: boundary is inserted_at itself, so now == inserted_at is expired.
+    assert is_expired(10, 0, 10) is True
+
+
+def test_alive_strictly_before_boundary():
+    # now < inserted_at + ttl stays alive.
+    assert is_expired(10, 5, 14) is False
+
+
+def test_expired_exactly_at_boundary():
+    # now == inserted_at + ttl is expired (boundary inclusive on expired side).
+    assert is_expired(10, 5, 15) is True
+
+
+def test_expired_strictly_after_boundary():
+    # now > inserted_at + ttl is expired.
+    assert is_expired(10, 5, 16) is True
+
+
+def test_positive_ttl_alive_at_insertion_and_expired_at_boundary():
+    # Positive TTL sanity: alive at inserted_at, expired at inserted_at + ttl.
+    assert is_expired(10, 5, 10) is False
+    assert is_expired(10, 5, 15) is True
+
+
+def test_zero_ttl_boundary_types_are_bool():
+    # Exact input expressions and result type checks.
+    result = is_expired(0, 0, 0)
+    assert result is True
+    assert isinstance(result, bool)
