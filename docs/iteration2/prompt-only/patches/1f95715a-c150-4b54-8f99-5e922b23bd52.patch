--- a/tests/test_pagination_one_based_regression.py
+++ b/tests/test_pagination_one_based_regression.py
@@ -0,0 +1,53 @@
+from pagination import paginate
+
+
+def test_literal_example_one_based():
+    # Literal example from the issue: range(1,8), page=2, size=2 -> [3,4]
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert type(result) is list
+
+
+def test_first_page():
+    result = paginate(range(1, 8), 1, 2)
+    assert result == [1, 2]
+    assert type(result) is list
+
+
+def test_last_partial_page():
+    result = paginate(range(1, 8), 4, 2)
+    assert result == [7]
+    assert type(result) is list
+
+
+def test_beyond_last_page_returns_empty():
+    result = paginate(range(1, 8), 5, 2)
+    assert result == []
+    assert type(result) is list
+
+
+def test_empty_input_preserved():
+    result = paginate([], 1, 2)
+    assert result == []
+    assert type(result) is list
+
+
+def test_invalid_page_zero_returns_empty():
+    assert paginate(range(1, 8), 0, 2) == []
+
+
+def test_invalid_negative_size_returns_empty():
+    assert paginate(range(1, 8), 1, -1) == []
+
+
+def test_size_larger_than_input():
+    result = paginate(range(1, 8), 1, 100)
+    assert result == [1, 2, 3, 4, 5, 6, 7]
+    assert type(result) is list
+
+
+def test_input_not_mutated():
+    items = [1, 2, 3, 4, 5, 6, 7]
+    snapshot = list(items)
+    paginate(items, 2, 2)
+    assert items == snapshot
--- a/tests/test_pagination_regression.py
+++ b/tests/test_pagination_regression.py
@@ -0,0 +1,44 @@
+from pagination import paginate
+
+
+def test_literal_example_one_based():
+    # Literal example from the issue: range(1,8), page=2, size=2 -> [3,4]
+    result = paginate(range(1, 8), 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+
+
+def test_first_page():
+    assert paginate(range(1, 8), 1, 2) == [1, 2]
+
+
+def test_last_partial_page():
+    assert paginate(range(1, 8), 4, 2) == [7]
+
+
+def test_beyond_last_page_returns_empty():
+    assert paginate(range(1, 8), 5, 2) == []
+
+
+def test_empty_input_preserved():
+    assert paginate([], 1, 2) == []
+
+
+def test_invalid_page_and_size_return_empty():
+    assert paginate([1, 2, 3], 0, 2) == []
+    assert paginate([1, 2, 3], 1, 0) == []
+    assert paginate([1, 2, 3], -1, 2) == []
+    assert paginate([1, 2, 3], 1, -2) == []
+
+
+def test_size_larger_than_input():
+    assert paginate(range(1, 8), 1, 100) == [1, 2, 3, 4, 5, 6, 7]
+
+
+def test_input_not_mutated_and_return_type():
+    data = [1, 2, 3, 4, 5]
+    snapshot = list(data)
+    result = paginate(data, 2, 2)
+    assert result == [3, 4]
+    assert isinstance(result, list)
+    assert data == snapshot
