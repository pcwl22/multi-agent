--- a/tests/test_exporter_csv_regression.py
+++ b/tests/test_exporter_csv_regression.py
@@ -0,0 +1,68 @@
+import csv
+import io
+
+from exporter import export_rows
+
+
+def test_empty_input_returns_empty_string():
+    result = export_rows([])
+    assert result == ""
+    assert isinstance(result, str)
+
+
+def test_simple_rows_unchanged():
+    result = export_rows([["a", 1], ["b", 2]])
+    assert result == "a,1\nb,2\n"
+    assert isinstance(result, str)
+
+
+def test_cell_with_comma_is_quoted_and_round_trips():
+    rows = [["a,b", "c"]]
+    result = export_rows(rows)
+    assert result == '"a,b",c\n'
+    assert list(csv.reader(io.StringIO(result))) == [["a,b", "c"]]
+
+
+def test_cell_with_double_quote_is_doubled_and_quoted():
+    rows = [['say "hi"', "x"]]
+    result = export_rows(rows)
+    assert result == '"say ""hi""",x\n'
+    assert list(csv.reader(io.StringIO(result))) == [['say "hi"', "x"]]
+
+
+def test_cell_with_newline_is_quoted_and_preserved():
+    rows = [["line1\nline2", "z"]]
+    result = export_rows(rows)
+    assert result == '"line1\nline2",z\n'
+    assert list(csv.reader(io.StringIO(result))) == [["line1\nline2", "z"]]
+
+
+def test_unicode_is_preserved_exactly():
+    rows = [["caf\u00e9", "\u65e5\u672c\u8a9e", "\U0001f600"]]
+    result = export_rows(rows)
+    assert result == "caf\u00e9,\u65e5\u672c\u8a9e,\U0001f600\n"
+    assert list(csv.reader(io.StringIO(result))) == [["caf\u00e9", "\u65e5\u672c\u8a9e", "\U0001f600"]]
+
+
+def test_output_uses_lf_only():
+    rows = [["a", "b"], ["c\nd", "e"]]
+    result = export_rows(rows)
+    assert "\r" not in result
+    assert result == 'a,b\n"c\nd",e\n'
+
+
+def test_round_trip_complex_rows():
+    rows = [
+        ["plain", "with,comma", 'with"quote', "with\nnewline"],
+        ["\u00e9\u00e8\u00ea", "\u4f60\u597d", "\U0001f680"],
+        ["", "", ""],
+    ]
+    result = export_rows(rows)
+    assert list(csv.reader(io.StringIO(result))) == rows
+
+
+def test_non_string_cells_are_stringified():
+    rows = [[1, 2.5, None, True]]
+    result = export_rows(rows)
+    assert result == "1,2.5,None,True\n"
+    assert list(csv.reader(io.StringIO(result))) == [["1", "2.5", "None", "True"]]
