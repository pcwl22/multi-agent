+#!/usr/bin/env python
+
+import unittest
+
+from jsonpointer import (
+    JsonPointer,
+    JsonPointerException,
+    resolve_pointer,
+    set_pointer,
+)
+
+
+# A digit string long enough to exceed CPython's default integer
+# string-conversion digit limit (sys.get_int_max_str_digits(), default 4300).
+LONG_INDEX = '1' * 5000
+
+
+class LongNumericIndexRegressionTests(unittest.TestCase):
+    """Regression tests for over-limit numeric sequence indices."""
+
+    def test_resolve_long_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b', 'c']
+        ptr = JsonPointer('/' + LONG_INDEX)
+        with self.assertRaises(JsonPointerException):
+            ptr.resolve(doc)
+
+    def test_resolve_pointer_long_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b', 'c']
+        with self.assertRaises(JsonPointerException):
+            resolve_pointer(doc, '/' + LONG_INDEX)
+
+    def test_to_last_long_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b', 'c']
+        ptr = JsonPointer('/' + LONG_INDEX)
+        with self.assertRaises(JsonPointerException):
+            ptr.to_last(doc)
+
+    def test_set_long_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b', 'c']
+        ptr = JsonPointer('/' + LONG_INDEX)
+        with self.assertRaises(JsonPointerException):
+            ptr.set(doc, 'x')
+
+    def test_set_pointer_long_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b', 'c']
+        with self.assertRaises(JsonPointerException):
+            set_pointer(doc, '/' + LONG_INDEX, 'x')
+
+    def test_resolve_with_default_returns_exact_default(self):
+        doc = ['a', 'b', 'c']
+        default = object()
+        ptr = JsonPointer('/' + LONG_INDEX)
+        result = ptr.resolve(doc, default)
+        self.assertIs(result, default)
+
+    def test_resolve_pointer_with_default_returns_exact_default(self):
+        doc = ['a', 'b', 'c']
+        default = {'sentinel': 1}
+        result = resolve_pointer(doc, '/' + LONG_INDEX, default)
+        self.assertIs(result, default)
+
+    def test_long_numeric_dict_key_remains_string(self):
+        doc = {LONG_INDEX: 'value'}
+        ptr = JsonPointer('/' + LONG_INDEX)
+        self.assertEqual(ptr.resolve(doc), 'value')
+        self.assertEqual(resolve_pointer(doc, '/' + LONG_INDEX), 'value')
+
+    def test_ordinary_array_index_still_resolves(self):
+        doc = ['a', 'b', 'c']
+        self.assertEqual(resolve_pointer(doc, '/0'), 'a')
+        self.assertEqual(resolve_pointer(doc, '/2'), 'c')
+
+    def test_ordinary_array_index_still_sets(self):
+        doc = ['a', 'b', 'c']
+        result = set_pointer(doc, '/1', 'B')
+        self.assertEqual(result, ['a', 'B', 'c'])
+        self.assertIs(result, doc)
+
+    def test_end_of_list_handling_preserved(self):
+        doc = ['a', 'b']
+        ptr = JsonPointer('/-')
+        result = ptr.resolve(doc)
+        self.assertEqual(result.list_, doc)
+
+    def test_out_of_range_index_raises_jsonpointerexception(self):
+        doc = ['a', 'b']
+        with self.assertRaises(JsonPointerException):
+            resolve_pointer(doc, '/5')
+
+    def test_set_mutation_behavior_preserved(self):
+        doc = {'foo': {'bar': 1}}
+        result = set_pointer(doc, '/foo/bar', 2)
+        self.assertIs(result, doc)
+        self.assertEqual(doc, {'foo': {'bar': 2}})
+
+    def test_set_not_inplace_does_not_mutate(self):
+        doc = {'foo': {'bar': 1}}
+        result = set_pointer(doc, '/foo/bar', 2, inplace=False)
+        self.assertEqual(result, {'foo': {'bar': 2}})
+        self.assertEqual(doc, {'foo': {'bar': 1}})
+
+
+if __name__ == '__main__':
+    unittest.main()
