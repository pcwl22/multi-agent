--- a/tests/test_export_rows_csv.py
+++ b/tests/test_export_rows_csv.py
@@ -0,0 +1,87 @@
+import csv
+import io
+
+from exporter import export_rows
+
+
+def _round_trip(text):
+    return list(csv.reader(io.StringIO(text)))
+
+
+def test_empty_input_returns_empty_string():
+    result = export_rows([])
+    assert result == ""
+    assert isinstance(result, str)
+
+
+def test_simple_rows_unchanged():
+    assert export_rows([["a", 1], ["b", 2]]) == "a,1\nb,2\n"
+
+
+def test_simple_rows_round_trip():
+    rows = [["a", "1"], ["b", "2"]]
+    assert _round_trip(export_rows(rows)) == rows
+
+
+def test_cell_with_comma_is_quoted_and_round_trips():
+    rows = [["a,b", "c"]]
+    out = export_rows(rows)
+    assert '"a,b",c\n' == out
+    assert _round_trip(out) == rows
+
+
+def test_cell_with_double_quote_is_escaped_and_round_trips():
+    rows = [['he said "hi"', "x"]]
+    out = export_rows(rows)
+    assert '"he said ""hi""",x\n' == out
+    assert _round_trip(out) == rows
+
+
+def test_cell_with_lf_is_quoted_and_round_trips():
+    rows = [["line1\nline2", "z"]]
+    out = export_rows(rows)
+    assert '"line1\nline2",z\n' == out
+    assert _round_trip(out) == rows
+
+
+def test_cell_with_cr_is_quoted_and_round_trips():
+    rows = [["a\rb", "z"]]
+    out = export_rows(rows)
+    assert _round_trip(out) == rows
+
+
+def test_cell_with_crlf_is_quoted_and_round_trips():
+    rows = [["a\r\nb", "z"]]
+    out = export_rows(rows)
+    assert _round_trip(out) == rows
+
+
+def test_mixed_special_characters_round_trip():
+    rows = [["a,b", 'q"q', "n\nn", "plain"]]
+    out = export_rows(rows)
+    assert _round_trip(out) == rows
+
+
+def test_unicode_is_preserved_verbatim():
+    rows = [["caf\u00e9", "\u4f60\u597d", "\U0001f600"]]
+    out = export_rows(rows)
+    assert "caf\u00e9" in out
+    assert "\u4f60\u597d" in out
+    assert "\U0001f600" in out
+    assert _round_trip(out) == rows
+
+
+def test_output_uses_lf_only_and_no_cr():
+    rows = [["a", "b"], ["c", "d"]]
+    out = export_rows(rows)
+    assert "\r" not in out
+    assert out.endswith("\n")
+
+
+def test_arbitrary_cells_round_trip():
+    rows = [
+        ["", "", ""],
+        ["a,b", 'x"y', "p\nq", "\u00e9\U0001f600"],
+        ["trailing,", ",leading", "mid,comma"],
+    ]
+    assert _round_trip(export_rows(rows)) == rows
