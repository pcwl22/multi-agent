{
  "patches": [
    {
      "rationale": "The bug: `get_part` calls `int(part)` on a numeric string that passes the regex but exceeds Python's integer string conversion digit limit (default 4300), raising a bare `ValueError` instead of `JsonPointerException`. Fix by catching `ValueError` around `int(part)` and re-raising as `JsonPointerException`. This preserves ordinary indices, end-of-list handling, and mutation behavior. Numeric object member keys are unaffected because `Mapping` returns `part` as a string before reaching the int conversion. Add a NEW regression test file covering resolve, to_last, set, default-return, and long numeric object keys.",
      "edits": [
        {
          "path": "jsonpointer.py",
          "old": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            return int(part)",
          "new": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            try:\n                return int(part)\n            except ValueError:\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)"
        }
      ],
      "contract_tests": [
        "tests/test_huge_index_regression.py::test_resolve_huge_index_raises_jsonpointerexception: resolve_pointer([1,2,3], '/<4301-digit number>') raises JsonPointerException (not ValueError).",
        "tests/test_huge_index_regression.py::test_resolve_huge_index_default_returned: resolve_pointer([1,2,3], '/<4301-digit number>', 'DEFAULT') returns exactly the string 'DEFAULT'.",
        "tests/test_huge_index_regression.py::test_to_last_huge_index_raises_jsonpointerexception: JsonPointer('/<4301-digit number>').to_last([1,2,3]) raises JsonPointerException.",
        "tests/test_huge_index_regression.py::test_set_huge_index_raises_jsonpointerexception: set_pointer([1,2,3], '/<4301-digit number>', 9) raises JsonPointerException.",
        "tests/test_huge_index_regression.py::test_long_numeric_object_key_is_string: resolve_pointer({'<4301-digit number>': 'v'}, '/<4301-digit number>') returns 'v' (member key stays a string).",
        "tests/test_huge_index_regression.py::test_ordinary_indices_preserved: resolve_pointer([10,20,30], '/0') == 10 and resolve_pointer([10,20,30], '/2') == 30.",
        "tests/test_huge_index_regression.py::test_end_of_list_preserved: isinstance(resolve_pointer([1,2], '/-'), EndOfList) is True.",
        "tests/test_huge_index_regression.py::test_set_mutation_preserved: doc=[1,2,3]; set_pointer(doc, '/1', 99) mutates doc in place to [1,99,3] and returns the same object."
      ],
      "changed_files": [
        "jsonpointer.py"
      ],
      "applied": true
    }
  ],
