{
  "patches": [
    {
      "rationale": "The bug: `get_part` calls `int(part)` on a digit string that passes the array-index regex but exceeds Python's `sys.set_int_max_str_digits` limit, raising a raw `ValueError` that escapes `resolve`, `to_last`, and `set`. Fix: wrap the conversion in try/except and raise `JsonPointerException`. This preserves ordinary indices, end-of-list handling, mapping keys (which never reach the int conversion), and mutation semantics. New regression tests cover all contracts.",
      "edits": [
        {
          "path": "jsonpointer.py",
          "old": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            return int(part)",
          "new": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            try:\n                return int(part)\n            except ValueError:\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)"
        }
      ],
      "contract_tests": [
        "tests/test_long_index_regression.py::test_resolve_long_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).resolve([1,2,3]) raises JsonPointerException (not ValueError).",
        "tests/test_long_index_regression.py::test_to_last_long_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).to_last([1,2,3]) raises JsonPointerException (not ValueError).",
        "tests/test_long_index_regression.py::test_set_long_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).set([1,2,3], 99) raises JsonPointerException (not ValueError).",
        "tests/test_long_index_regression.py::test_resolve_long_index_returns_exact_default: sentinel = object(); JsonPointer('/' + '9'*5000).resolve([1,2,3], sentinel) is sentinel.",
        "tests/test_long_index_regression.py::test_long_numeric_object_key_is_string: doc = {'9'*5000: 'v'}; JsonPointer('/' + '9'*5000).resolve(doc) == 'v' and key type is str.",
        "tests/test_long_index_regression.py::test_ordinary_index_resolve_set_to_last: resolve '/foo/0' == 'bar'; set '/foo/0' mutates in place; to_last returns (list, 0) with int part.",
        "tests/test_long_index_regression.py::test_end_of_list_preserved: resolve '/foo/-' is EndOfList; set '/foo/-' appends.",
        "tests/test_long_index_regression.py::test_set_inplace_mutation_preserved: set_pointer inplace mutates original doc; inplace=False leaves original unchanged."
      ],
      "changed_files": [
        "jsonpointer.py"
      ],
      "applied": true
    }
  ],
