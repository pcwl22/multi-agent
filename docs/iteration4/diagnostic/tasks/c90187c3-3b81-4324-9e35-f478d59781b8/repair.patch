--- a/config.py
+++ b/config.py
@@ -1,4 +1,26 @@
+import copy
+from collections.abc import Mapping
+
+
 def merge_config(defaults, overrides):
-    result = dict(defaults)
-    result.update(overrides)
+    """Recursively merge ``overrides`` into ``defaults``.
+
+    Nested mappings are merged key by key, with override values winning at
+    leaves.  Lists (and other non-mapping values) are replaced wholesale, never
+    concatenated.  The returned mapping is independent of both inputs: it
+    shares no nested mutable objects with either, and neither input is mutated.
+    """
+    result = {}
+    for key, value in defaults.items():
+        if key in overrides:
+            override_value = overrides[key]
+            if isinstance(value, Mapping) and isinstance(override_value, Mapping):
+                result[key] = merge_config(value, override_value)
+            else:
+                result[key] = copy.deepcopy(override_value)
+        else:
+            result[key] = copy.deepcopy(value)
+    for key, value in overrides.items():
+        if key not in defaults:
+            result[key] = copy.deepcopy(value)
     return result
--- a/tests/test_merge_config_regression.py
+++ b/tests/test_merge_config_regression.py
@@ -0,0 +1,118 @@
+from config import merge_config
+
+
+def test_returns_all_keys_from_base_and_overrides():
+    base = {"a": 1, "b": 2}
+    overrides = {"b": 20, "c": 30}
+    result = merge_config(base, overrides)
+    assert isinstance(result, dict)
+    assert result == {"a": 1, "b": 20, "c": 30}
+
+
+def test_nested_mappings_are_merged_recursively():
+    base = {"db": {"host": "localhost", "port": 5432, "opts": {"ssl": False}}}
+    overrides = {"db": {"port": 6543, "opts": {"ssl": True}}}
+    result = merge_config(base, overrides)
+    assert result == {
+        "db": {"host": "localhost", "port": 6543, "opts": {"ssl": True}}
+    }
+    assert isinstance(result["db"], dict)
+    assert isinstance(result["db"]["opts"], dict)
+
+
+def test_override_wins_at_leaf():
+    base = {"a": {"b": {"c": 1}}}
+    overrides = {"a": {"b": {"c": 2}}}
+    result = merge_config(base, overrides)
+    assert result["a"]["b"]["c"] == 2
+
+
+def test_keys_only_in_overrides_are_included():
+    result = merge_config({"a": 1}, {"b": 2})
+    assert result == {"a": 1, "b": 2}
+
+
+def test_keys_only_in_base_are_preserved():
+    result = merge_config({"a": 1, "b": 2}, {"b": 3})
+    assert result == {"a": 1, "b": 3}
+
+
+def test_lists_are_replaced_not_concatenated():
+    base = {"items": [1, 2, 3]}
+    overrides = {"items": [4, 5]}
+    result = merge_config(base, overrides)
+    assert result["items"] == [4, 5]
+    assert isinstance(result["items"], list)
+
+
+def test_nested_lists_are_replaced_not_concatenated():
+    base = {"cfg": {"items": [1, 2, 3]}}
+    overrides = {"cfg": {"items": [9]}}
+    result = merge_config(base, overrides)
+    assert result["cfg"]["items"] == [9]
+
+
+def test_base_input_is_not_mutated():
+    base = {"a": 1, "nested": {"x": 1}, "items": [1, 2]}
+    overrides = {"a": 2, "nested": {"y": 2}, "items": [3]}
+    base_snapshot = {"a": 1, "nested": {"x": 1}, "items": [1, 2]}
+    merge_config(base, overrides)
+    assert base == base_snapshot
+
+
+def test_overrides_input_is_not_mutated():
+    base = {"a": 1, "nested": {"x": 1}}
+    overrides = {"a": 2, "nested": {"y": 2}, "items": [3]}
+    overrides_snapshot = {"a": 2, "nested": {"y": 2}, "items": [3]}
+    merge_config(base, overrides)
+    assert overrides == overrides_snapshot
+
+
+def test_result_shares_no_nested_objects_with_inputs():
+    base = {"nested": {"x": 1}, "items": [1, 2]}
+    overrides = {"nested": {"y": 2}, "items": [3]}
+    result = merge_config(base, overrides)
+    assert result["nested"] is not base["nested"]
+    assert result["nested"] is not overrides["nested"]
+    assert result["items"] is not base["items"]
+    assert result["items"] is not overrides["items"]
+
+
+def test_mutating_result_does_not_affect_inputs():
+    base = {"nested": {"x": 1}, "items": [1, 2]}
+    overrides = {"nested": {"y": 2}, "items": [3]}
+    result = merge_config(base, overrides)
+    result["nested"]["x"] = 999
+    result["items"].append(999)
+    assert base == {"nested": {"x": 1}, "items": [1, 2]}
+    assert overrides == {"nested": {"y": 2}, "items": [3]}
+
+
+def test_mutating_inputs_after_call_does_not_affect_result():
+    base = {"nested": {"x": 1}, "items": [1, 2]}
+    overrides = {"nested": {"y": 2}, "items": [3]}
+    result = merge_config(base, overrides)
+    base["nested"]["x"] = 999
+    base["items"].append(999)
+    overrides["nested"]["y"] = 999
+    overrides["items"].append(999)
+    assert result == {"nested": {"x": 1, "y": 2}, "items": [3]}
+
+
+def test_simple_overrides_still_work():
+    assert merge_config({"a": 1}, {"a": 2, "b": 3}) == {"a": 2, "b": 3}
+    assert merge_config({}, {}) == {}
+
+
+def test_empty_overrides_returns_independent_copy():
+    base = {"nested": {"x": 1}}
+    result = merge_config(base, {})
+    assert result == {"nested": {"x": 1}}
+    assert result["nested"] is not base["nested"]
+
+
+def test_empty_base_returns_independent_copy():
+    overrides = {"nested": {"x": 1}}
+    result = merge_config({}, overrides)
+    assert result == {"nested": {"x": 1}}
+    assert result["nested"] is not overrides["nested"]
