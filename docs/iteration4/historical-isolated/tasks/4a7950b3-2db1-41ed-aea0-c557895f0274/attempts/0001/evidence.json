  "diff": "--- a/jsonpointer.py\n+++ b/jsonpointer.py\n@@ -239,7 +239,13 @@\n             if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                 raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n \n-            return int(part)\n+            try:\n+                return int(part)\n+            except ValueError:\n+                # A syntactically valid numeric index may still exceed\n+                # Python's integer string conversion digit limit. Treat it\n+                # as an invalid sequence index rather than leaking ValueError.\n+                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n \n         elif hasattr(doc, '__getitem__'):\n             # Allow indexing via ducktyping\n",
