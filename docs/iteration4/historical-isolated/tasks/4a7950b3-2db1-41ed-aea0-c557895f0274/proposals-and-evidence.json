{
  "patches": [
    {
      "rationale": "The bug: `get_part` validates the token with `_RE_ARRAY_INDEX.fullmatch(str(part))` and then calls `int(part)`. For a valid numeric token with more digits than Python's `sys.int_info.str_digits_check_threshold` (default 4300), `int(part)` raises `ValueError: Exceeds the limit (4300 digits) for integer string conversion`, which leaks out of `resolve`, `to_last`, and `set` instead of raising `JsonPointerException`. Fix: wrap the `int(part)` conversion in a try/except ValueError and raise `JsonPointerException` with the same message style used for other invalid sequence indices. This preserves ordinary indices, end-of-list handling ('-'), mapping behavior (numeric member keys stay strings because Mapping branch returns `part` unchanged), and mutation behavior. `resolve` with a default already catches `JsonPointerException` and returns the default, so the fix makes the default path work for huge indices too.",
      "edits": [
        {
          "path": "jsonpointer.py",
          "old": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            return int(part)",
          "new": "            if not JsonPointer._RE_ARRAY_INDEX.fullmatch(str(part)):\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)\n\n            try:\n                return int(part)\n            except ValueError:\n                # A syntactically valid numeric index may still exceed\n                # Python's integer string conversion digit limit. Treat it\n                # as an invalid sequence index rather than leaking ValueError.\n                raise JsonPointerException(\"'%s' is not a valid sequence index\" % part)"
        }
      ],
      "contract_tests": [
        "tests/test_huge_index_regression.py::test_resolve_huge_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).resolve([1,2,3]) raises JsonPointerException (not ValueError).",
        "tests/test_huge_index_regression.py::test_resolve_huge_index_with_default_returns_default: JsonPointer('/' + '9'*5000).resolve([1,2,3], 'DEFAULT') returns exactly the string 'DEFAULT'.",
        "tests/test_huge_index_regression.py::test_resolve_pointer_huge_index_with_default: resolve_pointer([1,2,3], '/' + '9'*5000, None) returns None.",
        "tests/test_huge_index_regression.py::test_to_last_huge_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).to_last([1,2,3]) raises JsonPointerException.",
        "tests/test_huge_index_regression.py::test_set_huge_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).set([1,2,3], 'x') raises JsonPointerException.",
        "tests/test_huge_index_regression.py::test_set_pointer_huge_index_raises_jsonpointerexception: set_pointer([1,2,3], '/' + '9'*5000, 'x') raises JsonPointerException.",
        "tests/test_huge_index_regression.py::test_huge_numeric_mapping_key_stays_string: resolve_pointer({'9'*5000: 'v'}, '/' + '9'*5000) == 'v' (numeric object member keys remain strings, however long).",
        "tests/test_huge_index_regression.py::test_ordinary_array_index_preserved: resolve_pointer(['a','b','c'], '/1') == 'b' and type is str.",
        "tests/test_huge_index_regression.py::test_end_of_list_preserved: resolve_pointer(['a','b'], '/-') is an EndOfList instance.",
        "tests/test_huge_index_regression.py::test_set_mutation_preserved: doc = {'a': [1,2]}; set_pointer(doc, '/a/0', 9) mutates doc in place to {'a': [9,2]} and returns the same object.",
        "tests/test_huge_index_regression.py::test_set_inplace_false_does_not_mutate: doc = {'a': [1,2]}; result = set_pointer(doc, '/a/0', 9, inplace=False); doc unchanged, result == {'a': [9,2]}."
      ],
      "changed_files": [
        "jsonpointer.py"
      ],
