--- a/tests/test_regression_checkout_totals.py
+++ b/tests/test_regression_checkout_totals.py
@@ -0,0 +1,37 @@
+from checkout import invoice_total
+from money import discounted
+
+
+def test_discount_treats_value_as_percent():
+    # 20 means 20%, so 100 -> 80
+    result = discounted(100, 20)
+    assert result == 80
+    assert isinstance(result, (int, float))
+
+
+def test_discount_zero_preserves_amount():
+    assert discounted(100, 0) == 100
+    assert discounted(0, 20) == 0
+
+
+def test_invoice_total_applies_tax_to_discounted_subtotal():
+    # 100, 20% discount -> 80 subtotal; 10% tax on 80 -> 88
+    result = invoice_total(100, 20, 0.1)
+    assert result == 88
+    assert isinstance(result, (int, float))
+
+
+def test_invoice_total_combined_example():
+    assert invoice_total(100, 20, 10) == 88
+
+
+def test_invoice_total_no_discount_preserves_behavior():
+    assert invoice_total(100, 0, 0.1) == 110
+
+
+def test_invoice_total_no_tax_preserves_behavior():
+    assert invoice_total(100, 20, 0) == 80
+
+
+def test_invoice_total_zero_amount():
+    assert invoice_total(0, 20, 0.1) == 0
