{
  "patches": [
    {
      "rationale": "money.discounted currently treats percent as a fraction (1 - percent), so 20 means 2000% off. Fix: divide percent by 100. checkout.invoice_total applies tax to the original amount; fix: apply tax to the discounted subtotal. Preserve no-discount/no-tax behavior: discounted(100,0)=100, invoice_total(100,0,0.1)=110, invoice_total(0,20,0.1)=0. Add a NEW regression test file (existing tests are immutable) covering the issue example 100, 20, 10% = 88, plus boundary and type contracts.",
      "edits": [
        {
          "path": "money.py",
          "old": "def discounted(amount, percent):\n    return amount * (1 - percent)",
          "new": "def discounted(amount, percent):\n    return amount * (1 - percent / 100)"
        },
        {
          "path": "checkout.py",
          "old": "    subtotal = discounted(amount, discount_percent)\n    return round(subtotal + amount * tax_rate, 2)",
          "new": "    subtotal = discounted(amount, discount_percent)\n    return round(subtotal + subtotal * tax_rate, 2)"
        }
      ],
      "contract_tests": [
        "tests/test_regression_discount_tax.py::test_discounted_percent_is_percentage: discounted(100, 20) == 80 (20 means 20%, not 2000%)",
        "tests/test_regression_discount_tax.py::test_discounted_no_discount_preserved: discounted(100, 0) == 100 and type is int",
        "tests/test_regression_discount_tax.py::test_discounted_zero_amount: discounted(0, 20) == 0",
        "tests/test_regression_discount_tax.py::test_discounted_full_discount: discounted(100, 100) == 0",
        "tests/test_regression_discount_tax.py::test_invoice_total_issue_example: invoice_total(100, 20, 0.1) == 88 (tax on discounted subtotal)",
        "tests/test_regression_discount_tax.py::test_invoice_total_no_discount_preserved: invoice_total(100, 0, 0.1) == 110",
        "tests/test_regression_discount_tax.py::test_invoice_total_no_tax_preserved: invoice_total(100, 20, 0) == 80",
        "tests/test_regression_discount_tax.py::test_invoice_total_zero_amount: invoice_total(0, 20, 0.1) == 0",
        "tests/test_regression_discount_tax.py::test_invoice_total_returns_float_rounded: invoice_total(100, 20, 0.1) == 88.0 and isinstance(invoice_total(100, 20, 0.1), float)"
      ],
      "changed_files": [
        "money.py",
        "checkout.py"
      ],
      "applied": true
    }
  ],
