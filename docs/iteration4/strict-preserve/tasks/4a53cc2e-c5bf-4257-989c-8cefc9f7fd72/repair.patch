--- a/tests/test_pricing_regression.py
+++ b/tests/test_pricing_regression.py
@@ -0,0 +1,41 @@
+from pricing import discounted_total
+
+
+def test_discounted_total_percentage_example():
+    result = discounted_total(100, 20)
+    assert result == 80
+    assert isinstance(result, int)
+
+
+def test_discounted_total_zero_amount_preserved():
+    result = discounted_total(0, 20)
+    assert result == 0
+    assert isinstance(result, int)
+
+
+def test_discounted_total_no_discount_preserved():
+    result = discounted_total(100, 0)
+    assert result == 100
+    assert isinstance(result, int)
+
+
+def test_discounted_total_full_discount_boundary():
+    result = discounted_total(100, 100)
+    assert result == 0
+    assert isinstance(result, int)
+
+
+def test_discounted_total_zero_discount_boundary():
+    result = discounted_total(100, 0)
+    assert result == 100
+
+
+def test_discounted_total_fractional_amount():
+    result = discounted_total(12.5, 0)
+    assert result == 12.5
+    assert isinstance(result, float)
+
+
+def test_discounted_total_percentage_midrange():
+    result = discounted_total(200, 25)
+    assert result == 150
