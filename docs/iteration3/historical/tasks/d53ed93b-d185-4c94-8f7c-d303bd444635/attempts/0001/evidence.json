      "contract_tests": [
        "tests/test_long_index_regression.py::test_resolve_long_numeric_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).resolve([1,2,3]) raises JsonPointerException (not ValueError).",
        "tests/test_long_index_regression.py::test_resolve_with_default_returns_exact_default: JsonPointer('/' + '9'*5000).resolve([1,2,3], 'DEFAULT') returns the exact string 'DEFAULT'.",
        "tests/test_long_index_regression.py::test_to_last_long_numeric_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).to_last([1,2,3]) raises JsonPointerException.",
        "tests/test_long_index_regression.py::test_set_long_numeric_index_raises_jsonpointerexception: JsonPointer('/' + '9'*5000).set([1,2,3], 'x') raises JsonPointerException.",
        "tests/test_long_index_regression.py::test_long_numeric_mapping_key_is_string: JsonPointer('/' + '9'*5000).resolve({'9'*5000: 'v'}) == 'v' (key stays a string).",
        "tests/test_long_index_regression.py::test_ordinary_index_still_works: JsonPointer('/1').resolve([10,20,30]) == 20 (int index preserved).",
        "tests/test_long_index_regression.py::test_end_of_list_preserved: resolve_pointer({'foo':['bar','baz']}, '/foo/-') is an EndOfList instance.",
        "tests/test_long_index_regression.py::test_set_mutation_preserved: set_pointer({'a':[1,2,3]}, '/a/1', 99) mutates in place to {'a':[1,99,3]}."
