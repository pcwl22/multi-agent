# Copy to an isolated .env after replacing paths and pinning your tested image ID.
# Supply OPENAI_API_KEY separately through secure process input/environment.
REPOPILOT_REPOSITORY_ROOT=CORPUS/sources
REPOPILOT_DATA_DIR=FRESH_TASK_DATA
REPOPILOT_MODEL_MODE=live
REPOPILOT_MODEL_NAME=deepseek-v4.1-flash
REPOPILOT_MODEL_BASE_URL=https://muyuan.do/v1
REPOPILOT_MAX_RETRIES=1
REPOPILOT_RETRY_WORKSPACE_POLICY=isolated
REPOPILOT_PATCH_TRANSACTIONS=true
REPOPILOT_TASK_BUDGETS=true
REPOPILOT_BUDGET_LIMITS='{"wall_seconds":900,"model_requests":8,"observed_tokens":100000,"sandbox_runs":6,"artifact_bytes":268435456,"result_bytes":8388608}'
REPOPILOT_CONTEXT_CHARS=24000
REPOPILOT_MODEL_TIMEOUT=120
REPOPILOT_MODEL_STREAMING=true
REPOPILOT_MODEL_STREAM_USAGE=true
REPOPILOT_MODEL_PATH_SCOPE=true
REPOPILOT_MODEL_MIN_INTERVAL=7.5
REPOPILOT_TEST_TIMEOUT=120
REPOPILOT_SANDBOX_IMAGE=sha256:REPLACE_WITH_TESTED_IMAGE_ID
