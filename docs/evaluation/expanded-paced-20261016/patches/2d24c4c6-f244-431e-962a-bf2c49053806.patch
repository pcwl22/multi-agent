--- a/inventory.py
+++ b/inventory.py
@@ -1,3 +1,6 @@
 def available_units(stock, reservations):
-    reserved = dict(reservations)
+    reserved = {}
+    for sku, qty in reservations:
+        if sku in stock:
+            reserved[sku] = reserved.get(sku, 0) + qty
     return {sku: max(0, qty - reserved.get(sku, 0)) for sku, qty in stock.items()}
--- a/tests/test_available_units_regression.py
+++ b/tests/test_available_units_regression.py
@@ -0,0 +1,22 @@
+from inventory import available_units
+
+
+def test_repeated_sku_reservations_all_subtracted():
+    assert available_units({"A": 10}, [("A", 2), ("A", 3)]) == {"A": 5}
+
+
+def test_clamped_at_zero():
+    assert available_units({"A": 4}, [("A", 2), ("A", 5)]) == {"A": 0}
+
+
+def test_unknown_skus_ignored():
+    assert available_units({"A": 10}, [("B", 3), ("A", 2)]) == {"A": 8}
+
+
+def test_inputs_preserved():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    result = available_units(stock, reservations)
+    assert result == {"A": 5}
+    assert stock == {"A": 10}
+    assert reservations == [("A", 2), ("A", 3)]
