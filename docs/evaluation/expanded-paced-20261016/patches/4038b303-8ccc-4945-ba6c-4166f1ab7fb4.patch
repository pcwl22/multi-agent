--- a/tests/test_regression_available_units.py
+++ b/tests/test_regression_available_units.py
@@ -0,0 +1,21 @@
+from inventory import available_units
+
+
+def test_repeated_sku_reservations_are_summed():
+    assert available_units({"A": 10}, [("A", 2), ("A", 3)]) == {"A": 5}
+
+
+def test_clamped_at_zero():
+    assert available_units({"A": 2}, [("A", 5)]) == {"A": 0}
+
+
+def test_unknown_sku_reservations_ignored():
+    assert available_units({"A": 10}, [("B", 4)]) == {"A": 10}
+
+
+def test_inputs_preserved():
+    stock = {"A": 10}
+    reservations = [("A", 2), ("A", 3)]
+    available_units(stock, reservations)
+    assert stock == {"A": 10}
+    assert reservations == [("A", 2), ("A", 3)]
