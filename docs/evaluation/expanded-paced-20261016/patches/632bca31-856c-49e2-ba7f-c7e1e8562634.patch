--- a/tests/test_available_units_regression.py
+++ b/tests/test_available_units_regression.py
@@ -0,0 +1,31 @@
+from inventory import available_units
+
+
+def test_repeated_sku_reservations_all_subtracted():
+    assert available_units({"A": 10}, [("A", 2), ("A", 3)]) == {"A": 5}
+
+
+def test_clamps_at_zero():
+    assert available_units({"A": 3}, [("A", 5)]) == {"A": 0}
+    assert available_units({"A": 3}, [("A", 2), ("A", 2)]) == {"A": 0}
+
+
+def test_unknown_skus_ignored():
+    assert available_units({"A": 10}, [("B", 4)]) == {"A": 10}
+    assert available_units({"A": 10}, [("A", 2), ("B", 4)]) == {"A": 8}
+
+
+def test_inputs_preserved():
+    stock = {"A": 10, "B": 5}
+    reservations = [("A", 2), ("A", 3), ("B", 1)]
+    stock_copy = dict(stock)
+    reservations_copy = list(reservations)
+    result = available_units(stock, reservations)
+    assert result == {"A": 5, "B": 4}
+    assert stock == stock_copy
+    assert reservations == reservations_copy
+
+
+def test_empty_inputs():
+    assert available_units({}, []) == {}
+    assert available_units({"A": 1}, []) == {"A": 1}
