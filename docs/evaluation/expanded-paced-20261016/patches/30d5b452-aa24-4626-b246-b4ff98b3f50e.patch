--- a/slugs.py
+++ b/slugs.py
@@ -1,5 +1,10 @@
 import re
+import unicodedata
 
 
 def slugify(value):
-    return re.sub(r"[^a-z0-9]+", "-", value.lower()).strip("-")
+    normalized = unicodedata.normalize("NFKD", value)
+    ascii_text = "".join(
+        ch for ch in normalized if not unicodedata.combining(ch)
+    )
+    return re.sub(r"[^a-z0-9]+", "-", ascii_text.lower()).strip("-")
--- a/tests/test_slugs_unicode.py
+++ b/tests/test_slugs_unicode.py
@@ -0,0 +1,17 @@
+from slugs import slugify
+
+
+def test_precomposed_accents_transliterate():
+    assert slugify("Caf\u00e9 d\u00e9j\u00e0 vu") == "cafe-deja-vu"
+
+
+def test_decomposed_accents_match_precomposed():
+    decomposed = "cafe\u0301"
+    precomposed = "caf\u00e9"
+    assert slugify(decomposed) == slugify(precomposed) == "cafe"
+
+
+def test_ascii_word_separation_and_dash_trimming_preserved():
+    assert slugify("  Hello, World!  ") == "hello-world"
+    assert slugify("---foo---bar---") == "foo-bar"
+    assert slugify("") == ""
