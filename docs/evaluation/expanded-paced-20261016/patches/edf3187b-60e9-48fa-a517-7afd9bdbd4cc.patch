--- a/tests/test_csv_export.py
+++ b/tests/test_csv_export.py
@@ -0,0 +1,52 @@
+import csv
+import io
+
+from exporter import export_rows
+
+
+def test_empty_rows():
+    assert export_rows([]) == ""
+
+
+def test_simple_rows_preserved():
+    assert export_rows([["a", 1], ["b", 2]]) == "a,1\nb,2\n"
+
+
+def test_lf_line_endings():
+    result = export_rows([["a", "b"], ["c", "d"]])
+    assert "\r" not in result
+    assert result == "a,b\nc,d\n"
+
+
+def test_cell_with_comma_is_quoted():
+    result = export_rows([["a,b", "c"]])
+    assert result == '"a,b",c\n'
+    assert list(csv.reader(io.StringIO(result))) == [["a,b", "c"]]
+
+
+def test_cell_with_quote_is_escaped():
+    result = export_rows([['say "hi"', "x"]])
+    assert list(csv.reader(io.StringIO(result))) == [['say "hi"', "x"]]
+
+
+def test_cell_with_newline_round_trips():
+    result = export_rows([["line1\nline2", "b"]])
+    assert list(csv.reader(io.StringIO(result))) == [["line1\nline2", "b"]]
+
+
+def test_unicode_preserved():
+    rows = [["caf\u00e9", "\u4f60\u597d"], ["\U0001f600", "ok"]]
+    result = export_rows(rows)
+    assert "caf\u00e9" in result
+    assert "\u4f60\u597d" in result
+    assert "\U0001f600" in result
+    assert list(csv.reader(io.StringIO(result))) == rows
+
+
+def test_round_trip_mixed_cells():
+    rows = [
+        ["plain", "with,comma", 'with"quote'],
+        ["with\nnewline", "", "trailing"],
+    ]
+    result = export_rows(rows)
+    assert list(csv.reader(io.StringIO(result))) == rows
