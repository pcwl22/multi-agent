--- a/config.py
+++ b/config.py
@@ -1,4 +1,27 @@
+import copy
+from collections.abc import Mapping
+
+
 def merge_config(defaults, overrides):
-    result = dict(defaults)
-    result.update(overrides)
+    """Recursively merge ``overrides`` into ``defaults``.
+
+    Nested mappings are merged recursively with override values winning at
+    the leaves. Lists (and any other non-mapping values) are replaced, not
+    concatenated. The returned structure is independent of both inputs: no
+    nested object is shared and neither input is mutated.
+    """
+    result = {}
+    for key, value in defaults.items():
+        result[key] = copy.deepcopy(value)
+
+    for key, value in overrides.items():
+        if (
+            key in result
+            and isinstance(result[key], Mapping)
+            and isinstance(value, Mapping)
+        ):
+            result[key] = merge_config(result[key], value)
+        else:
+            result[key] = copy.deepcopy(value)
+
     return result
--- a/tests/test_merge_config_recursive.py
+++ b/tests/test_merge_config_recursive.py
@@ -0,0 +1,62 @@
+from config import merge_config
+
+
+def test_nested_mappings_are_merged_recursively():
+    defaults = {"a": {"b": {"c": 1, "d": 2}, "e": 3}}
+    overrides = {"a": {"b": {"c": 10}}}
+    assert merge_config(defaults, overrides) == {
+        "a": {"b": {"c": 10, "d": 2}, "e": 3}
+    }
+
+
+def test_overrides_win_at_leaves():
+    defaults = {"a": {"b": 1}, "x": 1}
+    overrides = {"a": {"b": 2}, "x": 2}
+    assert merge_config(defaults, overrides) == {"a": {"b": 2}, "x": 2}
+
+
+def test_simple_overrides_preserved():
+    assert merge_config({"a": 1}, {"a": 2, "b": 3}) == {"a": 2, "b": 3}
+    assert merge_config({}, {}) == {}
+
+
+def test_lists_are_replaced_not_concatenated():
+    defaults = {"a": [1, 2, 3]}
+    overrides = {"a": [4]}
+    assert merge_config(defaults, overrides) == {"a": [4]}
+
+
+def test_inputs_are_not_mutated():
+    defaults = {"a": {"b": 1}, "l": [1, 2]}
+    overrides = {"a": {"b": 2}, "l": [3]}
+    defaults_copy = {"a": {"b": 1}, "l": [1, 2]}
+    overrides_copy = {"a": {"b": 2}, "l": [3]}
+    merge_config(defaults, overrides)
+    assert defaults == defaults_copy
+    assert overrides == overrides_copy
+
+
+def test_result_is_independent_of_inputs():
+    defaults = {"a": {"b": 1}, "l": [1, 2]}
+    overrides = {"a": {"b": 2}, "l": [3]}
+    result = merge_config(defaults, overrides)
+
+    # Mutating the result must not affect either input.
+    result["a"]["b"] = 999
+    result["l"].append(4)
+    assert defaults == {"a": {"b": 1}, "l": [1, 2]}
+    assert overrides == {"a": {"b": 2}, "l": [3]}
+
+    # Mutating an input must not affect the result.
+    defaults["a"]["b"] = -1
+    overrides["l"].append(5)
+    assert result["a"]["b"] == 999
+    assert result["l"] == [3, 4]
+
+
+def test_no_shared_nested_objects():
+    defaults = {"a": {"b": 1}}
+    overrides = {"c": {"d": 2}}
+    result = merge_config(defaults, overrides)
+    assert result["a"] is not defaults["a"]
+    assert result["c"] is not overrides["c"]
