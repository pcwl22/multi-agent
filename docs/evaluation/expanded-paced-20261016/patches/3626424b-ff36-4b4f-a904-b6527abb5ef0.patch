--- a/tests/test_export_rows_csv.py
+++ b/tests/test_export_rows_csv.py
@@ -0,0 +1,58 @@
+import csv
+import io
+
+from exporter import export_rows
+
+
+def _round_trip(rows):
+    text = export_rows(rows)
+    return list(csv.reader(io.StringIO(text)))
+
+
+def test_empty_input():
+    assert export_rows([]) == ""
+
+
+def test_simple_output_unchanged():
+    assert export_rows([["a", 1], ["b", 2]]) == "a,1\nb,2\n"
+
+
+def test_lf_line_endings():
+    text = export_rows([["a", "b"], ["c", "d"]])
+    assert "\r" not in text
+    assert text == "a,b\nc,d\n"
+
+
+def test_cell_with_comma():
+    rows = [["a,b", "c"]]
+    assert export_rows(rows) == '"a,b",c\n'
+    assert _round_trip(rows) == [list(map(str, row)) for row in rows]
+
+
+def test_cell_with_quote():
+    rows = [['he said "hi"', "x"]]
+    assert export_rows(rows) == '"he said ""hi""",x\n'
+    assert _round_trip(rows) == [list(map(str, row)) for row in rows]
+
+
+def test_cell_with_newline():
+    rows = [["line1\nline2", "z"]]
+    assert export_rows(rows) == '"line1\nline2",z\n'
+    assert _round_trip(rows) == [list(map(str, row)) for row in rows]
+
+
+def test_unicode_preserved():
+    rows = [["caf\u00e9", "\u4f60\u597d"], ["\U0001f600", "ok"]]
+    text = export_rows(rows)
+    assert "caf\u00e9" in text
+    assert "\u4f60\u597d" in text
+    assert "\U0001f600" in text
+    assert _round_trip(rows) == [list(map(str, row)) for row in rows]
+
+
+def test_round_trip_mixed_special_characters():
+    rows = [
+        ["plain", "with,comma", 'with"quote'],
+        ["with\nnewline", "\u00e9\u00e8", ""],
+    ]
+    assert _round_trip(rows) == [list(map(str, row)) for row in rows]
