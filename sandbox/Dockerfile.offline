# Build after downloading Linux wheels with scripts/prepare-offline-sandbox.ps1.
ARG PYTHON_IMAGE=python:3.12.14-slim
FROM ${PYTHON_IMAGE}
COPY sandbox/wheels /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels fastapi==0.136.3 httpx==0.28.1 pytest==8.3.4 && rm -rf /wheels
ENV PYTHONDONTWRITEBYTECODE=1 PYTEST_DISABLE_PLUGIN_AUTOLOAD=1
USER 65534:65534
WORKDIR /workspace
CMD ["python", "-m", "pytest", "tests", "-q"]
